{
  "name": "@absolutejs/geometry",
  "version": "0.8.0",
  "description": "Bounded geometry projection, oriented material components and point membership for worker-side web 3D tooling.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifold": {
      "types": "./dist/manifold.d.ts",
      "import": "./dist/manifold.js",
      "default": "./dist/manifold.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/geometry.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test ./tests",
    "check:package": "bun run build && bun test ./tests"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "manifold-3d": "3.5.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "manifold-3d": "3.5.1"
  },
  "peerDependenciesMeta": {
    "manifold-3d": {
      "optional": true
    }
  }
}
